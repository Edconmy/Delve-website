{
  "name": "delve-remotion",
  "version": "1.0.0",
  "description": "10-second looping video for Delve website",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render DelveLoop --output out/delve-loop.mp4",
    "render": "remotion render DelveLoop --output out/delve-loop.mp4 --codec h264"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "remotion": {
    "entryPoint": "./src/index.ts"
  }
}
